# PostgreSQL runs in Docker; the Next.js application runs on the host.
DATABASE_URL=postgresql://beauty:change-me@localhost:5432/beauty_business
POSTGRES_USER=beauty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beauty_business

# Public application origin and Better Auth secret (minimum 32 characters).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Configurable until the business confirms its definitive timezone.
BUSINESS_TIME_ZONE=America/Mexico_City
