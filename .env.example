# PostgreSQL runs in Docker locally; the Next.js application runs on the host.
# In Netlify, set DATABASE_URL in the site UI to an external Postgres. Do not run Compose there.
DATABASE_URL=postgresql://beauty:change-me@localhost:5432/beauty_business
POSTGRES_USER=beauty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beauty_business

# Public application origin and Better Auth secret (minimum 32 characters).
# In Netlify, set these in the site UI (not in this file). BETTER_AUTH_URL must be the public HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Configurable until the business confirms its definitive timezone.
BUSINESS_TIME_ZONE=America/Mexico_City

# Optional production bootstrap. Copy to a gitignored file such as .env.bootstrap.
# Never put real passwords here. Used by: npm run db:bootstrap -- --env-file=.env.bootstrap
# Do not name this file .env.production; Next.js would load it during build.
# BOOTSTRAP_USER_1_EMAIL=persona@ejemplo.com
# BOOTSTRAP_USER_1_NAME=Nombre visible
# BOOTSTRAP_USER_1_PASSWORD=
# BOOTSTRAP_USER_2_EMAIL=persona2@ejemplo.com
# BOOTSTRAP_USER_2_NAME=Nombre visible
# BOOTSTRAP_USER_2_PASSWORD=
